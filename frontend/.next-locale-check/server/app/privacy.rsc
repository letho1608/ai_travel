0:["wIEr8fqA1igLf9O2opwO_",[[["",{"children":["privacy",{"children":["__PAGE__",{}]}]},"$undefined","$undefined",true],["",{"children":["privacy",{"children":["__PAGE__",{},[["$L1",["$","main",null,{"className":"card legal-page","children":[["$","div",null,{"className":"eyebrow","children":"Phiên bản 2026-08-05"}],["$","h1",null,{"children":"Chính sách bảo mật"}],["$","p",null,{"className":"lead","children":"Bản chính sách minh bạch dữ liệu dành cho môi trường thử nghiệm. Trước khi vận hành thương mại, đơn vị vận hành phải bổ sung pháp nhân, đầu mối bảo vệ dữ liệu và hoàn tất đánh giá pháp lý."}],["$","h2",null,{"children":"Dữ liệu chúng tôi xử lý"}],["$","p",null,{"children":"Thông tin chuyến đi, vị trí bạn chủ động cung cấp, lịch sử chỉnh sửa, bình luận, phản hồi và mã phiên được dùng để tạo và đồng bộ lịch trình. Khi đăng nhập Google, hệ thống nhận mã định danh, email đã xác minh và tên hiển thị; không nhận mật khẩu Google."}],["$","h2",null,{"children":"Mục đích và thời hạn"}],["$","p",null,{"children":"Dữ liệu chỉ được dùng để lập kế hoạch, cộng tác, nhắc chuyến, hỗ trợ đặt dịch vụ và bảo vệ hệ thống. Kế hoạch ẩn danh có thời hạn mặc định 30 ngày theo thiết kế HLD; dữ liệu tài khoản được giữ cho tới khi người dùng yêu cầu xóa hoặc chính sách lưu trữ vận hành quy định ngắn hơn."}],["$","h2",null,{"children":"Nhà cung cấp và chuyển dữ liệu"}],["$","p",null,{"children":"Tùy cấu hình, dữ liệu tối thiểu có thể được gửi tới Google (đăng nhập), DeepSeek (tinh chỉnh văn bản), Open‑Meteo (thời tiết), OpenStreetMap/OSRM (địa điểm và tuyến đường), Amadeus (tìm kiếm dịch vụ), PostgreSQL và Redis. Giá và tình trạng chỗ không được gửi cho AI để bịa hoặc xác nhận thay nhà cung cấp."}],["$","h2",null,{"children":"Quyền và lựa chọn của bạn"}],["$","p",null,{"children":"Bạn có thể không đăng nhập, không cấp vị trí chính xác, tải bản sao lịch trình, chỉnh sửa dữ liệu hoặc yêu cầu truy cập, sửa, rút lại đồng ý và xóa dữ liệu. Việc rút đồng ý không làm thay đổi tính hợp pháp của xử lý đã diễn ra trước đó."}],["$","h2",null,{"children":"An toàn và liên hệ"}],["$","p",null,{"children":"Hệ thống áp dụng phân quyền chủ sở hữu, liên kết chia sẻ chỉ đọc, giới hạn tốc độ, nhật ký chi phí và không lưu bí mật trong mã nguồn. Kênh yêu cầu quyền riêng tư và thời hạn phản hồi phải được đơn vị triển khai cấu hình trước khi production."}]]}],null],null],null]},[null,["$","$L2",null,{"parallelRouterKey":"children","segmentPath":["children","privacy","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L3",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[[[["$","link","0",{"rel":"stylesheet","href":"/_next/static/css/154a607af3cb798a.css","precedence":"next","crossOrigin":"$undefined"}]],["$","html",null,{"lang":"vi","children":["$","body",null,{"children":["$","$L4",null,{"children":[["$","$L5",null,{}],["$","div",null,{"className":"shell","children":[["$","$L6",null,{}],["$","$L2",null,{"parallelRouterKey":"children","segmentPath":["children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L3",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":[["$","title",null,{"children":"404: This page could not be found."}],["$","div",null,{"style":{"fontFamily":"system-ui,\"Segoe UI\",Roboto,Helvetica,Arial,sans-serif,\"Apple Color Emoji\",\"Segoe UI Emoji\"","height":"100vh","textAlign":"center","display":"flex","flexDirection":"column","alignItems":"center","justifyContent":"center"},"children":["$","div",null,{"children":[["$","style",null,{"dangerouslySetInnerHTML":{"__html":"body{color:#000;background:#fff;margin:0}.next-error-h1{border-right:1px solid rgba(0,0,0,.3)}@media (prefers-color-scheme:dark){body{color:#fff;background:#000}.next-error-h1{border-right:1px solid rgba(255,255,255,.3)}}"}}],["$","h1",null,{"className":"next-error-h1","style":{"